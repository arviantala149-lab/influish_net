  <!--
    ================================================================
    CONNECTION STRING — Influish Database
    ================================================================
    Data Source is set to (localdb)\MSSQLLocalDB because that is
    the SQL Server instance confirmed installed on this machine
    (MSSQLLocalDB version 17.0.4025.3).

    If you move this project to another computer, change Data Source:
      (localdb)\MSSQLLocalDB  — Visual Studio LocalDB (current setup)
      .\SQLEXPRESS            — if SQL Server Express is installed
      YOURPC\SQLEXPRESS       — named SQL Server instance

    STEP: After running Database\InfluishDB.sql in SSMS, this
    connection string will automatically connect the Admin pages
    to the InfluishDB database.
    ================================================================
  -->
  <connectionStrings>
    <add name="InfluishDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=InfluishDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

