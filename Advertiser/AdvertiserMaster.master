<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdvertiserMaster.master.cs" Inherits="Influish_net.Advertiser.AdvertiserMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Influish Advertiser</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap 5 CSS for grid, layout & flex utilities -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" runat="server" />
    
    <!-- Influish Core Design System -->
    <link href="~/Content/influish.css" rel="stylesheet" type="text/css" runat="server" />
    
    <!-- Advertiser Portal Specific Stylesheet (Figma Layout, Cards, Tables, Nav) -->
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" runat="server" />
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%237C3AED'/><path d='M16 4L19.5 12.5L28 16L19.5 19.5L16 28L12.5 19.5L4 16L12.5 12.5Z' fill='white'/></svg>" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="frmAdvertiser" runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Path="~/Scripts/jquery-3.7.0.min.js" />
                <asp:ScriptReference Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Path="~/Scripts/WebForms/WebUIValidation.js" />
            </Scripts>
        </asp:ScriptManager>

        <div class="influish-app">

            <!-- ==============================
                 ADVERTISER SIDEBAR
                 ============================== -->
            <aside class="influish-sidebar">
                <!-- Brand / Logo -->
                <a href="Dashboard.aspx" class="influish-brand">
                    <div class="brand-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">Influish</span>
                        <span class="brand-tag">Advertiser Portal</span>
                    </div>
                </a>

                <!-- Navigation Links -->
                <nav class="influish-nav">
                    <a id="lnkDashboard" runat="server" href="~/Advertiser/Dashboard.aspx" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                        </span>
                        <span>Dashboard</span>
                    </a>

                    <a id="lnkCampaigns" runat="server" href="~/Advertiser/MyCampaigns.aspx" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m3 11 18-5v12L3 14v-3z"></path>
                                <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
                            </svg>
                        </span>
                        <span>My Campaigns</span>
                    </a>

                    <a id="lnkCreate" runat="server" href="~/Advertiser/CreateCampaign.aspx" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                        <span>Create Campaign</span>
                    </a>

                    <a id="lnkNotifications" runat="server" href="~/Advertiser/Notifications.aspx" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                        </span>
                        <span>Notifications</span>
                    </a>

                    <a id="lnkProfile" runat="server" href="~/Advertiser/CompanyProfile.aspx" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <span>Company Profile</span>
                    </a>
                </nav>

                <!-- Sidebar Footer Links -->
                <div class="influish-nav-footer">
                    <a href="~/Default.aspx" runat="server" class="influish-nav-item">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                        </span>
                        <span>Explore Marketplace</span>
                    </a>

                    <a href="~/Login.aspx?role=advertiser" runat="server" class="influish-nav-item" style="color: #EF4444;">
                        <span class="nav-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </span>
                        <span>Log Out</span>
                    </a>
                </div>
            </aside>

            <!-- ==============================
                 MAIN CONTENT & TOPBAR
                 ============================== -->
            <main class="influish-main">
                <!-- Topbar -->
                <header class="influish-topbar">
                    <div class="topbar-search">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Search influencers, campaigns..." />
                    </div>

                    <div class="topbar-actions">
                        <a href="Notifications.aspx" class="topbar-btn" title="Notifications">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="notification-badge"></span>
                        </a>

                        <a href="CompanyProfile.aspx" class="user-profile-badge">
                            <div class="user-avatar">
                                <asp:Literal ID="litAvatar" runat="server" Text="T" />
                            </div>
                            <div class="user-info">
                                <span class="user-name">
                                    <asp:Literal ID="litCompanyName" runat="server" Text="TechNova Solutions" />
                                </span>
                                <span class="user-role">Brand Account</span>
                            </div>
                        </a>
                    </div>
                </header>

                <!-- Page Content Area -->
                <div class="influish-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </main>

        </div>
    </form>
</body>
</html>
