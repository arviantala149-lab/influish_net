<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Influish_net.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Influish — India's #1 Creator Marketplace connecting brands with top influencers." />
    <title><%: Page.Title %> - Influish</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="~/Content/influish.css" rel="stylesheet" type="text/css" runat="server" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%237C3AED'/><path d='M16 4L19.5 12.5L28 16L19.5 19.5L16 28L12.5 19.5L4 16L12.5 12.5Z' fill='white'/></svg>" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Path="~/Scripts/jquery-3.7.0.min.js" />
                <asp:ScriptReference Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Path="~/Scripts/WebForms/WebUIValidation.js" />
            </Scripts>
        </asp:ScriptManager>

        <!-- ==============================
             PUBLIC NAVBAR
             ============================== -->
        <nav class="influish-navbar" id="mainNav">
            <div class="nav-container">
                <!-- Brand -->
                <a href="~/" runat="server" class="nav-brand">
                    <div class="brand-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                        </svg>
                    </div>
                    Influish
                </a>

                <!-- Nav Links -->
                <div class="nav-links">
                    <a href="~/Default.aspx" runat="server" id="navHome">How it Works</a>
                    <a href="~/ForInfluencers.aspx" runat="server" id="navInfluencers">For Influencers</a>
                    <a href="~/ForAdvertisers.aspx" runat="server" id="navAdvertisers">For Advertisers</a>
                </div>

                <!-- Actions -->
                <div class="nav-actions">
                    <a href="~/Login.aspx" runat="server" class="btn-nav-login">Login</a>
                    <a href="~/Signup.aspx" runat="server" class="btn-nav-signup">Sign Up</a>
                </div>
            </div>
        </nav>

        <!-- ==============================
             PAGE CONTENT
             ============================== -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>

        <!-- ==============================
             PUBLIC FOOTER
             ============================== -->
        <footer class="influish-footer">
            <div class="footer-brand" style="display:flex;align-items:center;gap:8px;">
                <div class="brand-icon" style="width:22px;height:22px;background:var(--purple-primary);border-radius:5px;display:inline-flex;align-items:center;justify-content:center;color:#fff;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                    </svg>
                </div>
                Influish
            </div>
            <nav class="footer-links">
                <a href="~/About.aspx" runat="server">About Us</a>
                <a href="~/TermsOfService.aspx" runat="server">Terms of Service</a>
                <a href="~/Contact.aspx" runat="server">Contact</a>
            </nav>
            <span class="footer-copy">&copy; <%: DateTime.Now.Year %> Influish. All rights reserved.</span>
        </footer>
    </form>

    <script>
        // Highlight active nav link
        (function () {
            var path = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll('.nav-links a');
            links.forEach(function (l) {
                if (l.href && l.href.toLowerCase().indexOf(path.replace('/', '')) > -1 && path !== '/') {
                    l.classList.add('active');
                }
            });
            if (path === '/' || path.indexOf('default') > -1) {
                var hw = document.getElementById('navHome');
                if (hw) hw.classList.add('active');
            }
        })();
    </script>
</body>
</html>
