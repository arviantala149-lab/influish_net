<%--
    ================================================================
    Admin/AdminMaster.master  —  Admin Master Page (Shared Layout)
    Language  : C# (inline runat="server" block)
    Purpose   : Provides the sidebar, top bar, and ContentPlaceHolders
                that every Admin page reuses.
    Syllabus  : Section 6 — Master Pages, Section 8 — Session State
    ================================================================

    WHAT IS A MASTER PAGE?
    A master page is a template. Instead of repeating the sidebar
    and topbar HTML on every page, we write it once here and all
    Admin pages inherit it using MasterPageFile="~/Admin/AdminMaster.master"
    ================================================================
--%>

<%-- ============================================================
<<<<<<< Updated upstream
     VB SERVER-SIDE CODE — runs before the page is sent to browser
     ============================================================ --%>
<script runat="server">

    ' ── Page_Load runs every time ANY Admin page is loaded ────────
    Protected Sub Page_Load(ByVal sender As Object, ByVal e As EventArgs)
        ' SESSION PROTECTION — if no Admin session exists, go to Login
        ' Session("AdminLoggedIn") is set in Login.aspx after successful login
        If Session("AdminLoggedIn") Is Nothing Then
            Response.Redirect("~/Admin/Login.aspx")
            Return   ' stop further processing
        End If

        ' Display the Admin name from session in the top bar
        Dim adminName As String = If(Session("AdminName") IsNot Nothing,
                                     Session("AdminName").ToString(), "Admin")
        Dim adminRole As String = If(Session("AdminRole") IsNot Nothing,
                                     Session("AdminRole").ToString(), "System Admin")

        lblAdminName.Text = adminName
        lblAdminRole.Text = adminRole

        ' Show the first letter of the Admin name as the avatar
        lblAvatar.Text = If(adminName.Length > 0,
                            adminName(0).ToString().ToUpper(), "A")

        ' ── Highlight the active sidebar link ─────────────────────
        ' Get just the filename of the current page (e.g. "Dashboard.aspx")
        Dim currentPage As String = System.IO.Path.GetFileName(
                                        Request.Url.AbsolutePath).ToLower()

        Select Case currentPage
            Case "dashboard.aspx"
                lnkDashboard.CssClass = "nav-item active"
            Case "manageusers.aspx"
                lnkUsers.CssClass = "nav-item active"
            Case "managecampaigns.aspx"
                lnkCampaigns.CssClass = "nav-item active"
            Case "reportssupport.aspx"
                lnkReports.CssClass = "nav-item active"
        End Select
    End Sub

    ' ── Logout Button Click ────────────────────────────────────────
    Protected Sub btnLogout_Click(ByVal sender As Object, ByVal e As EventArgs)
        ' Clear ALL session data (removes AdminLoggedIn, AdminName, etc.)
        Session.Clear()
        Session.Abandon()  ' completely destroys the session

        ' Send user back to Login page
        Response.Redirect("~/Admin/Login.aspx")
    End Sub
