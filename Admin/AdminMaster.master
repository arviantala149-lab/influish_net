<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.master.cs" Inherits="Influish_net.Admin.AdminMaster" %>
<%--
    Admin/AdminMaster.master — Admin Master Page
--%>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel — Influish</title>

    <%-- Admin CSS — one folder up from the Admin/ subfolder --%>
    <link href="../Content/admin.css" rel="stylesheet" />

    <%-- ContentPlaceHolder for per-page <title> or extra CSS --%>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

    <%-- The <form runat="server"> must wrap ALL server controls.
         In a master page, this one form covers ALL content pages. --%>
    <form id="frmAdminMaster" runat="server">
        <div class="admin-wrapper">

            <%-- ══════════════════════════════════════════════════
                 SIDEBAR — fixed left panel, 260px wide
                 Contains: Logo, Navigation links, Logout button
                 ══════════════════════════════════════════════════ --%>
            <nav class="sidebar">

                <%-- Brand / Logo --%>
                <div class="sidebar-brand">
                    <div class="sidebar-logo-icon">i</div>
                    <div>
                        <div class="sidebar-brand-name">Influish</div>
                        <div class="sidebar-brand-sub">Influencer Admin</div>
                    </div>
                </div>

                <%-- Navigation Links
                     asp:HyperLink renders as an <a> tag.
                     CssClass is updated to "nav-item active"
                     in Page_Load for the current page. --%>
                <div class="sidebar-nav">

                    <asp:HyperLink ID="lnkDashboard" runat="server"
                        CssClass="nav-item"
                        NavigateUrl="~/Admin/Dashboard.aspx">
                        <span class="nav-icon">&#9632;</span>&nbsp; Dashboard
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkUsers" runat="server"
                        CssClass="nav-item"
                        NavigateUrl="~/Admin/ManageUsers.aspx">
                        <span class="nav-icon">&#128100;</span>&nbsp; Users
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkCampaigns" runat="server"
                        CssClass="nav-item"
                        NavigateUrl="~/Admin/ManageCampaigns.aspx">
                        <span class="nav-icon">&#128203;</span>&nbsp; Campaigns
                    </asp:HyperLink>

                    <asp:HyperLink ID="lnkReports" runat="server"
                        CssClass="nav-item"
                        NavigateUrl="~/Admin/ReportsSupport.aspx">
                        <span class="nav-icon">&#128229;</span>&nbsp; Reports &amp; Support
                    </asp:HyperLink>

                </div>

                <%-- Logout at bottom of sidebar --%>
                <div class="sidebar-footer">
                    <%-- asp:Button with OnClick triggers btnLogout_Click above --%>
                    <asp:Button ID="btnLogout" runat="server"
                        CssClass="logout-btn"
                        Text="&#8594; Logout"
                        OnClick="btnLogout_Click" />
                </div>

            </nav>
            <%-- end sidebar --%>


            <%-- ══════════════════════════════════════════════════
                 MAIN CONTENT AREA — everything to the right of sidebar
                 ══════════════════════════════════════════════════ --%>
            <div class="main-content">

                <%-- Top Bar --%>
                <div class="topbar">
                    <div class="topbar-title">
                        <%-- Each page puts its own title here --%>
                        <asp:ContentPlaceHolder ID="PageTitle" runat="server">
                            Admin Panel
                        </asp:ContentPlaceHolder>
                    </div>
                    <div class="topbar-right">
                        <%--<div class="topbar-bell" title="Notifications">&#128276;</div>%>--%>
                        <div class="topbar-admin">
                            <div>
                                <div class="topbar-admin-name">
                                    <asp:Label ID="lblAdminName" runat="server" Text="Admin" />
                                </div>
                                <div class="topbar-admin-role">
                                    <asp:Label ID="lblAdminRole" runat="server" Text="System Admin" />
                                </div>
                            </div>
                            <div class="topbar-avatar">
                                <asp:Label ID="lblAvatar" runat="server" Text="A" />
                            </div>
                        </div>
                    </div>
                </div>
                <%-- end topbar --%>

                <%-- Page Body — each Admin page fills this area --%>
                <div class="page-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>

            </div>
            <%-- end main-content --%>

        </div>
        <%-- end admin-wrapper --%>
    </form>

</body>
</html>
